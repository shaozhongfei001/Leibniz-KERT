[Unit]
# KERT Python Core —— 唯一公共入口（M2.7）
#
# 安装：
#   sudo cp deploy/systemd/kert-api.service /etc/systemd/system/
#   sudo mkdir -p /etc/kert && sudo cp deploy/.env.example /etc/kert/api.env
#   sudo chmod 600 /etc/kert/api.env   # 含 API Key，必须限权
#   sudo systemctl daemon-reload && sudo systemctl enable --now kert-api
#
# 路径约定（安装时按实际环境调整）：
#   代码      /opt/kert
#   虚拟环境  /opt/kert/.venv
#   工作区    /var/lib/kert/workspace
#   配置      /etc/kert/api.env
Description=KERT Python Core API (knowledge service, port 8106)
Documentation=file:///opt/kert/docs/architecture/KERT_HYBRID_DEPLOYMENT_AND_OPERATIONS_V1.0_CANDIDATE.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kert
Group=kert
WorkingDirectory=/opt/kert

# 环境变量从受限权限文件读取，避免 API Key 出现在 unit 文件或进程命令行
EnvironmentFile=/etc/kert/api.env
Environment=PYTHONPATH=/opt/kert/src
Environment=PYTHONUNBUFFERED=1

# 仅监听回环：TLS 与对外暴露由反向代理负责（见部署文档 §2.2）
# 生产 profile 下若绑非回环地址且未启用认证，启动会被拒绝（fail-fast）
ExecStart=/opt/kert/.venv/bin/python /opt/kert/scripts/serve_skill_service.py \
    --host 127.0.0.1 \
    --port 8106 \
    --workspace /var/lib/kert/workspace

Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

# 结构化日志输出到 journald，由 journald 统一轮转与采集
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kert-api

# ---------- 安全加固 ----------
# 文件系统：只读系统目录，仅工作区与备份目录可写
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/kert
PrivateTmp=yes

# 权限：禁止提权与新特权
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=

# 内核与设备
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
PrivateDevices=yes

# 网络：仅需 IPv4/IPv6/Unix
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# ---------- 资源上限 ----------
# 依 WBS M2.10 资源基线；实际值需按生产负载调整
LimitNOFILE=65535
MemoryMax=2G
TasksMax=512

[Install]
WantedBy=multi-user.target
