[Unit]
# KERT 备份定时任务（M2.7，补齐 M2-P5 登记的「无调度集成」遗留项）
#
# 安装：
#   sudo cp deploy/systemd/kert-backup.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now kert-backup.timer
#   systemctl list-timers kert-backup.timer   # 确认下次触发时间
#
# 重要：备份频率对应 RPO，保留策略对应存储成本。
# 本模板给出的 daily 仅为**占位默认**，实际值属 Owner 决策
# （见 evidence/m2-p5/README.md §9）。
Description=KERT workspace backup (timer-driven)
Documentation=file:///opt/kert/docs/architecture/KERT_HYBRID_DEPLOYMENT_AND_OPERATIONS_V1.0_CANDIDATE.md

[Service]
Type=oneshot
User=kert
Group=kert
WorkingDirectory=/opt/kert
Environment=PYTHONPATH=/opt/kert/src

# 备份目标必须在工作区之外，否则工具会拒绝执行
# （落入工作区会触发 WS_BAD_FILENAME 破坏一致性检查）
ExecStart=/opt/kert/.venv/bin/python /opt/kert/scripts/kert_ops.py backup \
    --workspace /var/lib/kert/workspace \
    --dest /var/backups/kert

# 备份后立即校验：未校验的备份等于没有备份
ExecStartPost=/bin/sh -c 'latest=$(ls -1dt /var/backups/kert/backup-* 2>/dev/null | head -1); \
    if [ -n "$latest" ]; then \
        /opt/kert/.venv/bin/python /opt/kert/scripts/kert_ops.py verify --backup "$latest"; \
    fi'

StandardOutput=journal
StandardError=journal
SyslogIdentifier=kert-backup

# 备份需读工作区、写备份目录
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/backups/kert
ReadOnlyPaths=/var/lib/kert
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
