[Unit]
# KERT 持久化异步 Worker（M2.7）
#
# 安装：
#   sudo cp deploy/systemd/kert-worker.service /etc/systemd/system/
#   sudo cp deploy/.env.example /etc/kert/worker.env
#   sudo chmod 600 /etc/kert/worker.env
#   sudo systemctl daemon-reload && sudo systemctl enable --now kert-worker
#
# Worker 无 HTTP 端口。它与 API 共享同一 SQLite Runtime Store，
# 故必须与 API 部署在**同一主机、同一文件系统**（ADR-015 单机单实例）。
#
# 未启动 Worker 的后果：异步入队的 Job 无人执行、永久积压。
# 可用 `python scripts/run_worker.py --workspace ... --stats` 查看队列深度。
Description=KERT Persistent Async Worker (job queue consumer)
Documentation=file:///opt/kert/docs/architecture/KERT_PERSISTENT_WORKER_M2P2.md
After=network-online.target kert-api.service
Wants=network-online.target
# 与 API 同生共死：API 停则 Worker 停（二者共享同一 Runtime Store）
PartOf=kert-api.service

[Service]
Type=simple
User=kert
Group=kert
WorkingDirectory=/opt/kert

EnvironmentFile=/etc/kert/worker.env
Environment=PYTHONPATH=/opt/kert/src
Environment=PYTHONUNBUFFERED=1

ExecStart=/opt/kert/.venv/bin/python /opt/kert/scripts/run_worker.py \
    --workspace /var/lib/kert/workspace

Restart=always
RestartSec=5

# 优雅停机：Worker 收到 SIGTERM 后不再领取新 Job，等当前 Job 完成后退出。
# TimeoutStopSec 须大于单个 Job 的最长执行时间，否则会被 SIGKILL 打断，
# 导致 lease 未释放、需等 lease 过期才能被回收（延长恢复时间）。
TimeoutStopSec=120
KillSignal=SIGTERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=kert-worker

# ---------- 安全加固 ----------
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/kert
PrivateTmp=yes

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
PrivateDevices=yes

RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

LimitNOFILE=65535
MemoryMax=2G
TasksMax=256

[Install]
WantedBy=multi-user.target
