# DKWS 部署环境变量模板（M2.7）
#
# 用法：cp deploy/.env.example deploy/.env 并填入真实值。
#
# 安全要求：
#   - .env 已在 .gitignore 中，切勿提交
#   - 文件权限建议 600（chmod 600 deploy/.env）
#   - 生产环境更推荐用配置文件的 digest 形式（见 DKWS_RUNTIME_HARDENING_M2P1 §3.2）
#     或由密钥管理系统注入，避免明文落盘

# ---------- 必填 ----------

# API Key 声明，格式：key_id:secret:scope1|scope2，多个用逗号分隔
# 作用域：read / execute / admin
# 密钥长度须 >= 16 字符，否则生产 profile 拒绝启动
# 生成建议：openssl rand -hex 24
DKWS_API_KEYS=gits-caller:CHANGE_ME_AT_LEAST_16_CHARS:read|execute,ops-admin:CHANGE_ME_TOO_16_CHARS:read|execute|admin

# ---------- 可选（含默认值） ----------

# 日志级别
DKWS_LOG_LEVEL=INFO

# 限流：每分钟请求数
DKWS_RATE_LIMIT_RPM=600

# /metrics 是否要求 admin 作用域
# 生产建议 true；若采集器无法携带密钥，改为 false 并由网络层限制来源
DKWS_METRICS_REQUIRE_ADMIN=true

# 是否脱敏 API JSON 响应
# 默认 false：既有响应契约依赖原文。开启前需确认调用方能接受掩码值
DKWS_REDACT_RESPONSE=false

# Worker lease 租约时长（秒）
# 需大于单个 Job 最长执行时间的一半（心跳间隔为 lease 的 40%）
DKWS_WORKER_LEASE_SECONDS=30

# Worker 空闲轮询间隔（秒）
DKWS_WORKER_POLL_INTERVAL=1.0

# ---------- 不要在此配置 ----------
#
# DKWS_PROFILE      已在 compose 中固定为 prod
# DKWS_BIND_HOST    容器内固定 0.0.0.0，对外暴露由 ports 的回环绑定控制
# LLM 凭据          由外部密钥管理注入，不写入本文件
