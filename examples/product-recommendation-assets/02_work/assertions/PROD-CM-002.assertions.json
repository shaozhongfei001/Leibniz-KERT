      "evidenceIds": [
        "EVS-REGCM001-9a0b9ffd"
      ],
      "fieldPath": "compliance.regulatoryBasis",
      "knowledgeState": "CANDIDATE",
      "normalizedValue": null,
      "productId": "PROD-CM-002",
      "productVersionScope": "version=2026.09.06.1",
      "rawValue": "开户单位有下列情形之一的，开户银行应当依照中国人民银行的规定，责令其停止违法活动，并可根据情节轻重处以罚款：（一）超出规定范围、限额使用现金的；（二）超出核定的库存现金限额留存现金的。（2011 年 1 月 8 日删除）",
      "reviewDecisionId": null,
      "supersedes": null,
      "valueType": "TEXT"
    },
    {
