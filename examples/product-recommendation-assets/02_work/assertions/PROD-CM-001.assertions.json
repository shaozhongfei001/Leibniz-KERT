      "knowledgeState": "CANDIDATE",
      "normalizedValue": null,
      "productId": "PROD-CM-001",
      "productVersionScope": "version=2026.09.06.1",
      "rawValue": "违反本办法规定，伪造、变造、私自印制开户登记证的存款人，属非经营性的处以 1000 元罚款；属经营性的处以 1 万元以上 3 万元以下的罚款；构成犯罪的，移交司法机关依法追究刑事责任。",
      "reviewDecisionId": null,
      "supersedes": null,
      "valueType": "TEXT"
