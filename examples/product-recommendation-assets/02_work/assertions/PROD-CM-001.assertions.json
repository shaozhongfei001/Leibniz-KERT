      "productVersionScope": "version=2026.09.06.1",
      "rawValue": "中国人民银行负责监督、检查银行结算账户的开立和使用，对存款人、银行违反银行结算账户管理规定的行为予以处罚。",
      "reviewDecisionId": null,
      "supersedes": null,
      "valueType": "TEXT"
    },
