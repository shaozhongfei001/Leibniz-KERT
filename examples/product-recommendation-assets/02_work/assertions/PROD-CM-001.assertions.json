      ],
      "fieldPath": "compliance.regulatoryBasis",
      "knowledgeState": "CANDIDATE",
      "normalizedValue": null,
      "productId": "PROD-CM-001",
      "productVersionScope": "version=2026.09.06.1",
      "rawValue": "单位银行结算账户支付给个人银行结算账户款项的，银行应按第四十条、第四十一条规定认真审查付款依据或收款依据的原件，并留存复印件，按会计档案保管。未提供相关依据或相关依据不符合规定的，银行应拒绝办理。",
      "reviewDecisionId": null,
      "supersedes": null,
      "valueType": "TEXT"
    },
    {
      "applicabilityScope": {
        "effectiveFrom": "2026-09-06",
        "effectiveTo": null
      },
      "assertionId": "ASM-PRODCM001-b2fff4f1",
      "conflictId": null,
      "createdAt": "2026-09-22T19:10:00+08:00",
      "createdByRunId": "RUN-20260922-2922ed36",
      "evidenceIds": [
        "EVS-REGCM002-10787611"
      ],
      "fieldPath": "compliance.regulatoryBasis",
      "knowledgeState": "CANDIDATE",
      "normalizedValue": null,
      "productId": "PROD-CM-001",
      "productVersionScope": "version=2026.09.06.1",
      "rawValue": "银行应按规定与存款人核对账务。银行结算账户的存款人收到对账单或对账信息后，应及时核对账务并在规定期限内向银行发出对账回单或确认信息。",
      "reviewDecisionId": null,
      "supersedes": null,
      "valueType": "TEXT"
    },
    {
      "applicabilityScope": {
        "effectiveFrom": "2026-09-06",
        "effectiveTo": null
      },
      "assertionId": "ASM-PRODCM001-4aa93855",
      "conflictId": null,
      "createdAt": "2026-09-22T19:10:00+08:00",
      "createdByRunId": "RUN-20260922-2922ed36",
      "evidenceIds": [
        "EVS-REGCM002-ba384794"
      ],
      "fieldPath": "compliance.regulatoryBasis",
      "knowledgeState": "CANDIDATE",
      "normalizedValue": null,
      "productId": "PROD-CM-001",
      "productVersionScope": "version=2026.09.06.1",
      "rawValue": "存款人应按照本办法的规定使用银行结算账户办理结算业务。",
      "reviewDecisionId": null,
      "supersedes": null,
      "valueType": "TEXT"
    },
    {
      "applicabilityScope": {
        "effectiveFrom": "2026-09-06",
        "effectiveTo": null
      },
      "assertionId": "ASM-PRODCM001-3b392d48",
      "conflictId": null,
      "createdAt": "2026-09-22T19:10:00+08:00",
      "createdByRunId": "RUN-20260922-2922ed36",
      "evidenceIds": [
        "EVS-REGCM002-0290d4b6"
      ],
      "fieldPath": "compliance.regulatoryBasis",
      "knowledgeState": "CANDIDATE",
      "normalizedValue": null,
      "productId": "PROD-CM-001",
      "productVersionScope": "version=2026.09.06.1",
      "rawValue": "银行得知存款人有本办法第四十九条第一、二项情况，存款人超过规定期限未主动办理撤销银行结算账户手续的，银行有权停止其银行结算账户的对外支付。",
      "reviewDecisionId": null,
      "supersedes": null,
      "valueType": "TEXT"
    },
    {
      "applicabilityScope": {
        "effectiveFrom": "2026-09-06",
        "effectiveTo": null
      },
      "assertionId": "ASM-PRODCM001-035ede1a",
      "conflictId": null,
      "createdAt": "2026-09-22T19:10:00+08:00",
      "createdByRunId": "RUN-20260922-2922ed36",
      "evidenceIds": [
        "EVS-REGCM002-71855351"
      ],
      "fieldPath": "compliance.regulatoryBasis",
      "knowledgeState": "CANDIDATE",
      "normalizedValue": null,
      "productId": "PROD-CM-001",
      "productVersionScope": "version=2026.09.06.1",
      "rawValue": "存款人撤销银行结算账户，必须与开户银行核对银行结算账户存款余额，交回各种重要空白票据及结算凭证和开户登记证，银行核对无误后方可办理销户手续。存款人未按规定交回各种重要空白票据及结算凭证的，应出具有关证明，造成损失的，由其自行承担。",
      "reviewDecisionId": null,
      "supersedes": null,
      "valueType": "TEXT"
    },
