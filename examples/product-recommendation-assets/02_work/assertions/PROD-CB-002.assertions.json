      "normalizedValue": null,
      "productId": "PROD-CB-002",
      "productVersionScope": "version=2026.09.06.1",
      "rawValue": "担保人为第三方债务人向债权人提供物权担保，构成内保外贷或外保内贷的，应当按照内保外贷或外保内贷相关规定办理担保登记手续，并遵守相关规定。",
      "reviewDecisionId": null,
      "supersedes": null,
      "valueType": "TEXT"
    },
    {
