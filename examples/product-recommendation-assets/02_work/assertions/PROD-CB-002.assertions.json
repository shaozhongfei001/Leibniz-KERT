      "normalizedValue": null,
      "productId": "PROD-CB-002",
      "productVersionScope": "version=2026.09.06.1",
      "rawValue": "当担保人与债权人分属境内、境外，或担保物权登记地（或财产所在地、收益来源地）与担保人、债权人的任意一方分属境内、境外时，境内担保人或境内债权人应按下列规定办理相关外汇管理手续：",
      "reviewDecisionId": null,
      "supersedes": null,
      "valueType": "TEXT"
    },
