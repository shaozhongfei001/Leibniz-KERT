      "productVersionScope": "version=2026.09.06.1",
      "rawValue": "境内机构提供或接受跨境担保，应当遵守国家法律法规和行业主管部门的规定，并按本规定办理相关外汇管理手续。",
      "reviewDecisionId": null,
      "supersedes": null,
      "valueType": "TEXT"
    },
