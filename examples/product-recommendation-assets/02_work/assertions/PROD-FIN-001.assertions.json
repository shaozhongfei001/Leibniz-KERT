      "productVersionScope": "version=2026.09.06.1",
      "rawValue": "流动资金贷款利率应当遵循利率市场化原则，由借贷双方在遵守国家有关规定的前提下协商确定。",
      "reviewDecisionId": null,
      "supersedes": null,
      "valueType": "TEXT"
    },
