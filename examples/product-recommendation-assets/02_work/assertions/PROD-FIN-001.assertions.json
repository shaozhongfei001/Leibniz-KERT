      "productVersionScope": "version=2026.09.06.1",
      "rawValue": "贷款人开展流动资金贷款业务，应当遵循依法合规、审慎经营、平等自愿、公平诚信的原则。",
      "reviewDecisionId": null,
      "supersedes": null,
      "valueType": "TEXT"
    },
