      ],
      "fieldPath": "compliance.regulatoryBasis",
      "knowledgeState": "CANDIDATE",
      "normalizedValue": null,
      "productId": "PROD-IB-001",
      "productVersionScope": "version=2026.09.06.1",
      "rawValue": "商业银行开办并购贷款业务应当遵循依法合规、审慎经营、风险可控、商业可持续的原则。",
      "reviewDecisionId": null,
      "supersedes": null,
      "valueType": "TEXT"
    },
    {
      "applicabilityScope": {
        "effectiveFrom": "2026-09-06",
        "effectiveTo": null
      },
      "assertionId": "ASM-PRODIB001-5b5dd6a5",
      "conflictId": null,
      "createdAt": "2026-09-22T20:05:00+08:00",
      "createdByRunId": "RUN-20260922-2922ed36",
      "evidenceIds": [
        "EVS-REGIB001-713392c5"
      ],
      "fieldPath": "compliance.regulatoryBasis",
      "knowledgeState": "CANDIDATE",
      "normalizedValue": null,
      "productId": "PROD-IB-001",
      "productVersionScope": "version=2026.09.06.1",
      "rawValue": "商业银行开展尽职调查，应当全面涵盖并购双方的相关情况，包括但不限于目标企业或者资产的商业价值、潜在回报和估值水平，并购双方的股东结构、公司治理、经营状况、财务情况和整体资信，并购交易的合规性等。涉及担保的，应当全面调查担保人的担保能力、抵质押物价值等。",
      "reviewDecisionId": null,
      "supersedes": null,
      "valueType": "TEXT"
    },
    {
      "applicabilityScope": {
        "effectiveFrom": "2026-09-06",
        "effectiveTo": null
      },
      "assertionId": "ASM-PRODIB001-28da74f6",
      "conflictId": null,
      "createdAt": "2026-09-22T20:05:00+08:00",
      "createdByRunId": "RUN-20260922-2922ed36",
      "evidenceIds": [
        "EVS-REGIB001-3375183b"
      ],
      "fieldPath": "compliance.regulatoryBasis",
      "knowledgeState": "CANDIDATE",
      "normalizedValue": null,
      "productId": "PROD-IB-001",
      "productVersionScope": "version=2026.09.06.1",
      "rawValue": "商业银行应当在全面分析战略风险、法律与合规风险、整合风险、经营及财务风险等与并购有关的各项风险的基础上，审慎评估并购贷款的风险，重点评估借款人的偿债能力，同时关注并购后目标企业的发展前景、协同效应和经营效益，综合评估对并购贷款的影响。涉及跨境交易的，还应当分析国别风险、汇率风险和资金过境风险等。",
      "reviewDecisionId": null,
      "supersedes": null,
      "valueType": "TEXT"
    },
    {
      "applicabilityScope": {
        "effectiveFrom": "2026-09-06",
        "effectiveTo": null
      },
      "assertionId": "ASM-PRODIB001-41f40d76",
      "conflictId": null,
      "createdAt": "2026-09-22T20:05:00+08:00",
      "createdByRunId": "RUN-20260922-2922ed36",
      "evidenceIds": [
        "EVS-REGIB001-ba508e87"
      ],
      "fieldPath": "compliance.regulatoryBasis",
      "knowledgeState": "CANDIDATE",
      "normalizedValue": null,
      "productId": "PROD-IB-001",
      "productVersionScope": "version=2026.09.06.1",
      "rawValue": "商业银行评估法律与合规风险，包括但不限于以下内容：",
      "reviewDecisionId": null,
      "supersedes": null,
      "valueType": "TEXT"
    },
    {
      "applicabilityScope": {
        "effectiveFrom": "2026-09-06",
        "effectiveTo": null
      },
      "assertionId": "ASM-PRODIB001-307a835c",
      "conflictId": null,
      "createdAt": "2026-09-22T20:05:00+08:00",
      "createdByRunId": "RUN-20260922-2922ed36",
      "evidenceIds": [
        "EVS-REGIB001-9610bfbf"
      ],
      "fieldPath": "compliance.regulatoryBasis",
      "knowledgeState": "CANDIDATE",
      "normalizedValue": null,
      "productId": "PROD-IB-001",
      "productVersionScope": "version=2026.09.06.1",
      "rawValue": "商业银行原则上应当要求借款人提供能够覆盖并购贷款风险的担保，包括但不限于资产抵押和股权质押，以及符合法律规定的其他形式的担保。以目标企业股权质押时，商业银行应当采用更为审慎的方法，评估其股权价值和确定质押率。",
      "reviewDecisionId": null,
      "supersedes": null,
      "valueType": "TEXT"
    },
    {
      "applicabilityScope": {
        "effectiveFrom": "2026-09-06",
        "effectiveTo": null
      },
      "assertionId": "ASM-PRODIB001-5472aca5",
      "conflictId": null,
      "createdAt": "2026-09-22T20:05:00+08:00",
      "createdByRunId": "RUN-20260922-2922ed36",
      "evidenceIds": [
        "EVS-REGIB001-d3dab6fd"
      ],
      "fieldPath": "compliance.regulatoryBasis",
      "knowledgeState": "CANDIDATE",
      "normalizedValue": null,
      "productId": "PROD-IB-001",
      "productVersionScope": "version=2026.09.06.1",
      "rawValue": "商业银行在贷款发放前应当确认借款人满足合同约定的提款条件。提款条件应当至少包括除并购贷款外其他并购交易资金已按约定的支付进度足额到位、并购交易合规性条件已满足等内容。",
      "reviewDecisionId": null,
      "supersedes": null,
      "valueType": "TEXT"
    },
    {
      "applicabilityScope": {
        "effectiveFrom": "2026-09-06",
        "effectiveTo": null
      },
      "assertionId": "ASM-PRODIB001-62527605",
      "conflictId": null,
