      "extractionRunId": "RUN-20260906-9d34c845",
      "fragmentId": "FRG-SRCCM001-0014",
      "locator": {
        "clause": "第十四条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "客户通过企业网银办理的，应当使用数字证书或经本行认可的双因素认证方式。",
      "quoteHash": "f92129c26b1d04e12fcb608f59e9260ba1325e8c23d3a612640f9587208f775b",
      "retrievedAt": "2026-09-06T12:00:00+08:00",
