      },
      "authorityLevel": "INTERNAL_POLICY",
      "claimType": "ELIGIBILITY",
      "evidenceId": "EVS-SRCCM001-b8dc5f5f",
      "extractionRunId": "RUN-20260906-9d34c845",
      "fragmentId": "FRG-SRCCM001-0012",
      "locator": {
        "clause": "第十二条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "客户申请调整最低留存余额的，应当向开户行提交书面申请，由一级分行交易银行部审批。",
      "quoteHash": "b8dc5f5f1b8e3280ed4c9f5337091a00934a8351fbe98380922f0ba03b8c2c81",
      "retrievedAt": "2026-09-06T12:00:00+08:00",
