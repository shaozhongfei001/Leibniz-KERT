      },
      "authorityLevel": "INTERNAL_POLICY",
      "claimType": "ELIGIBILITY",
      "evidenceId": "EVS-SRCXFAM001-5d9a0338",
      "extractionRunId": "RUN-20260922-415977d1",
      "fragmentId": "FRG-SRCXFAM001-0014",
      "locator": {
        "clause": "第十四条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "因特殊情形确需突破本办法准入标准的，应当由一级分行风险管理部出具书面意见，报总行风险管理部审批。",
      "quoteHash": "5d9a0338b28ad5c4fcc564d0e729752911da1109b34647625ca0662aca82be17",
      "retrievedAt": "2026-09-22T00:00:00+08:00",
