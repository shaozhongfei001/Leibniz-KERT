      "fragmentId": "FRG-REGTF003-0093",
      "locator": {
        "clause": "第九十三条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "支票的背书、付款行为和追索权的行使，除本章规定外，适用本法第二章有关汇票的规定。",
      "quoteHash": "083a0ad7dc9339c2a6858f3ff3aef4a9f35c1a0038c997e2a5240042df54f62d",
