      "extractionRunId": "RUN-20260922-84773271",
      "fragmentId": "FRG-REGTF003-0091",
      "locator": {
        "clause": "第九十一条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "支票的持票人应当自出票日起十日内提示付款；异地使用的支票，其提示付款的期限由中国人民银行另行规定。",
      "quoteHash": "7386390b00295315bce54f417ca6306789a6e99d359776f91a43f6000a58f750",
      "retrievedAt": "2026-09-22T21:40:00+08:00",
