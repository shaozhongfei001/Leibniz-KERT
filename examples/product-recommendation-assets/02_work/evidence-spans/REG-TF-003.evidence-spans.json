      "sourceId": "REG-TF-003",
      "sourcePath": "01_raw/_authoritative/REG-TF-003.md",
      "sourceVersionId": "SV-REGTF003-20260922-fd3ba439",
      "usage": "AUTHORITATIVE"
    },
    {
      "applicabilityScope": {
        "effectiveFrom": "2026-09-06",
        "effectiveTo": null
      },
      "authorityLevel": "REGULATORY",
      "claimType": "REGULATORY",
      "evidenceId": "EVS-REGTF003-9d999004",
      "extractionRunId": "RUN-20260922-84773271",
      "fragmentId": "FRG-REGTF003-0009",
      "locator": {
        "clause": "第九条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "票据上的记载事项必须符合本法的规定。",
      "quoteHash": "9d9990040197cdd49c7c217d3043bd630ad27f3c11b8765dea9a53d3012b7dd7",
      "retrievedAt": "2026-09-22T21:40:00+08:00",
