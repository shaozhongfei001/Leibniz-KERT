      "locator": {
        "clause": "第一百零三条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "有前条所列行为之一，情节轻微，不构成犯罪的，依照国家有关规定给予行政处罚。",
      "quoteHash": "0d7da01b398205b6d6246663da7aa95316cdd3f8263ae6f6ce09c9ef500bdeff",
      "retrievedAt": "2026-09-22T21:40:00+08:00",
