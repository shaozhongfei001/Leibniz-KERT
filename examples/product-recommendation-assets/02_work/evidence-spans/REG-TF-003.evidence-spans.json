      "fragmentId": "FRG-REGTF003-0054",
      "locator": {
        "clause": "第五十四条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "持票人依照前条规定提示付款的，付款人必须在当日足额付款。",
      "quoteHash": "58badd5fb60c77bff067dc66db432f05b3d5a911dd77f92d92d06e78fa292c81",
      "retrievedAt": "2026-09-22T21:40:00+08:00",
      "sourceBytesHash": "fd3ba439c11d5c65d7aece2943cc37a814c431fb067fd5f41f14b65318d364b8",
      "sourceId": "REG-TF-003",
      "sourcePath": "01_raw/_authoritative/REG-TF-003.md",
