        "effectiveTo": null
      },
      "authorityLevel": "REGULATORY",
      "claimType": "REGULATORY",
      "evidenceId": "EVS-REGTF003-57957120",
      "extractionRunId": "RUN-20260922-84773271",
      "fragmentId": "FRG-REGTF003-0079",
      "locator": {
        "clause": "第七十九条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "本票的持票人未按照规定期限提示见票的，丧失对出票人以外的前手的追索权。",
      "quoteHash": "57957120e4b1ce39dd7e6cd3762eb84f16b4b98b8b0e0bc3ca13dd19e4bb3438",
      "retrievedAt": "2026-09-22T21:40:00+08:00",
