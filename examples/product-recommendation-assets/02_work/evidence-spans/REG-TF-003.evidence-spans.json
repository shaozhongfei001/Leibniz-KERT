      "claimType": "PROCESS",
      "evidenceId": "EVS-REGTF003-c5e954ea",
      "extractionRunId": "RUN-20260922-84773271",
      "fragmentId": "FRG-REGTF003-0081",
      "locator": {
        "clause": "第八十一条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "支票是出票人签发的，委托办理支票存款业务的银行或者其他金融机构在见票时无条件支付确定的金额给收款人或者持票人的票据。",
      "quoteHash": "c5e954ea5d9df004562a0d7ca9a7c19e4a7bc494270a6bcabb79d1a84f6635e8",
      "retrievedAt": "2026-09-22T21:40:00+08:00",
      "sourceBytesHash": "fd3ba439c11d5c65d7aece2943cc37a814c431fb067fd5f41f14b65318d364b8",
      "sourceId": "REG-TF-003",
      "sourcePath": "01_raw/_authoritative/REG-TF-003.md",
