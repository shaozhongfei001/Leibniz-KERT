      "claimType": "ELIGIBILITY",
      "evidenceId": "EVS-REGTF003-ade99bd7",
      "extractionRunId": "RUN-20260922-84773271",
      "fragmentId": "FRG-REGTF003-0073",
      "locator": {
        "clause": "第七十三条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "本票是出票人签发的，承诺自己在见票时无条件支付确定的金额给收款人或者持票人的票据。",
      "quoteHash": "ade99bd763b66685caf4f406981e8d8d3a46af9b5eeb2b28366e1054e23a7293",
      "retrievedAt": "2026-09-22T21:40:00+08:00",
      "sourceBytesHash": "fd3ba439c11d5c65d7aece2943cc37a814c431fb067fd5f41f14b65318d364b8",
      "sourceId": "REG-TF-003",
      "sourcePath": "01_raw/_authoritative/REG-TF-003.md",
