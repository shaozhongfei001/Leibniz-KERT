        "effectiveTo": null
      },
      "authorityLevel": "REGULATORY",
      "claimType": "REGULATORY",
      "evidenceId": "EVS-REGTF003-ee51a209",
      "extractionRunId": "RUN-20260922-84773271",
      "fragmentId": "FRG-REGTF003-0072",
      "locator": {
        "clause": "第七十二条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "被追索人依照前二条规定清偿债务后，其责任解除。",
      "quoteHash": "ee51a20965f6e7791366482c30e8aabfc2d99745e18bc4ac29d28fd80b6c6d14",
      "retrievedAt": "2026-09-22T21:40:00+08:00",
