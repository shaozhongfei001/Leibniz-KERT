      "locator": {
        "clause": "第四条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "票据出票人制作票据，应当按照法定条件在票据上签章，并按照所记载的事项承担票据责任。",
      "quoteHash": "d2c4db4eb427e1c179019d10009514b585d3733095f63934267bbca77bde0e90",
      "retrievedAt": "2026-09-22T21:40:00+08:00",
