        "effectiveTo": null
      },
      "authorityLevel": "REGULATORY",
      "claimType": "REGULATORY",
      "evidenceId": "EVS-REGTF003-3edf3ec6",
      "extractionRunId": "RUN-20260922-84773271",
      "fragmentId": "FRG-REGTF003-0065",
      "locator": {
        "clause": "第六十五条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "持票人不能出示拒绝证明、退票理由书或者未按照规定期限提供其他合法证明的，丧失对其前手的追索权。但是，承兑人或者付款人仍应当对持票人承担责任。",
      "quoteHash": "3edf3ec6ef8f4e81c6c5a1f4f49916ea050c8ee6e2b511e53288ee2119c9968b",
      "retrievedAt": "2026-09-22T21:40:00+08:00",
      "sourceBytesHash": "fd3ba439c11d5c65d7aece2943cc37a814c431fb067fd5f41f14b65318d364b8",
      "sourceId": "REG-TF-003",
      "sourcePath": "01_raw/_authoritative/REG-TF-003.md",
      "sourceVersionId": "SV-REGTF003-20260922-fd3ba439",
      "usage": "AUTHORITATIVE"
    },
    {
      "applicabilityScope": {
        "effectiveFrom": "2026-09-06",
        "effectiveTo": null
      },
      "authorityLevel": "REGULATORY",
      "claimType": "REGULATORY",
      "evidenceId": "EVS-REGTF003-a31e424e",
      "extractionRunId": "RUN-20260922-84773271",
      "fragmentId": "FRG-REGTF003-0071",
      "locator": {
        "clause": "第七十一条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "被追索人依照前条规定清偿后，可以向其他汇票债务人行使再追索权，请求其他汇票债务人支付下列金额和费用：",
      "quoteHash": "a31e424ed4c7a47d50b2f3f180c4968c97e30bc6b96de8960bc8c0919034c1a6",
      "retrievedAt": "2026-09-22T21:40:00+08:00",
      "sourceBytesHash": "fd3ba439c11d5c65d7aece2943cc37a814c431fb067fd5f41f14b65318d364b8",
      "sourceId": "REG-TF-003",
      "sourcePath": "01_raw/_authoritative/REG-TF-003.md",
      "sourceVersionId": "SV-REGTF003-20260922-fd3ba439",
      "usage": "AUTHORITATIVE"
    },
    {
      "applicabilityScope": {
