      "sourceVersionId": "SV-REGFIN001-20260922-dfa2dbff",
      "usage": "AUTHORITATIVE"
    },
    {
      "applicabilityScope": {
        "effectiveFrom": "2026-09-06",
        "effectiveTo": null
      },
      "authorityLevel": "REGULATORY",
      "claimType": "REGULATORY",
      "evidenceId": "EVS-REGFIN001-4bea3593",
      "extractionRunId": "RUN-20260922-2922ed36",
      "fragmentId": "FRG-REGFIN001-0043",
      "locator": {
        "clause": "第四十三条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "贷款人有下列情形之一的，国家金融监督管理总局及其派出机构可根据《中华人民共和国银行业监督管理法》对其采取相关监管措施或进行处罚：",
      "quoteHash": "4bea3593254bd194c7a9fb647fca11c306ef3068a8e9da051a52b9a063bdde24",
      "retrievedAt": "2026-09-22T19:10:00+08:00",
