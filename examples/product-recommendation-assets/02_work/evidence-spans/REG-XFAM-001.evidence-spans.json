      },
      "authorityLevel": "REGULATORY",
      "claimType": "PRICE",
      "evidenceId": "EVS-REGXFAM001-e91107bf",
      "extractionRunId": "RUN-20260922-84773271",
      "fragmentId": "FRG-REGXFAM001-0001",
      "locator": {
        "clause": "第一条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "为规范商业银行服务价格管理活动，保护客户合法权益，促进商业银行健康发展，根据《中华人民共和国银行业监督管理法》、《中华人民共和国商业银行法》、《中华人民共和国价格法》等法律法规，制定本办法。",
      "quoteHash": "e91107bf086d9d6e30b3b5345b1006c31e0b3a62db8da64a1dbc06b2e8e12f21",
      "retrievedAt": "2026-09-22T21:40:00+08:00",
      "sourceBytesHash": "300f1d6d68b475c37042e6782d7f882b8105dfca0121a4150879e19b9787d24b",
      "sourceId": "REG-XFAM-001",
      "sourcePath": "01_raw/_authoritative/REG-XFAM-001.md",
      "sourceVersionId": "SV-REGXFAM001-20260922-300f1d6d",
      "usage": "AUTHORITATIVE"
    },
    {
      "applicabilityScope": {
        "effectiveFrom": "2026-09-06",
        "effectiveTo": null
      },
      "authorityLevel": "REGULATORY",
      "claimType": "REGULATORY",
      "evidenceId": "EVS-REGXFAM001-0b940e85",
      "extractionRunId": "RUN-20260922-84773271",
      "fragmentId": "FRG-REGXFAM001-0002",
      "locator": {
        "clause": "第二条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "依据《中华人民共和国商业银行法》和《中华人民共和国外资银行管理条例》设立的商业银行，适用本办法有关规定。",
      "quoteHash": "0b940e8535bb9b20795974c5dc258602061b8f424876e4c8afb618fcc9280709",
      "retrievedAt": "2026-09-22T21:40:00+08:00",
      "sourceBytesHash": "300f1d6d68b475c37042e6782d7f882b8105dfca0121a4150879e19b9787d24b",
      "sourceId": "REG-XFAM-001",
      "sourcePath": "01_raw/_authoritative/REG-XFAM-001.md",
      "sourceVersionId": "SV-REGXFAM001-20260922-300f1d6d",
      "usage": "AUTHORITATIVE"
    },
    {
      "applicabilityScope": {
        "effectiveFrom": "2026-09-06",
        "effectiveTo": null
      },
      "authorityLevel": "REGULATORY",
      "claimType": "PRICE",
      "evidenceId": "EVS-REGXFAM001-c4294c40",
      "extractionRunId": "RUN-20260922-84773271",
      "fragmentId": "FRG-REGXFAM001-0004",
      "locator": {
        "clause": "第四条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "商业银行服务价格行为应当严格遵守国家法律、法规、规章和有关监管规定，遵循公开、公平、诚实、信用的原则，接受社会监督。",
      "quoteHash": "c4294c40b86b23e485b3d84e54f8b9873e7e12d16af5cebfcf534a684016d2bd",
      "retrievedAt": "2026-09-22T21:40:00+08:00",
      "sourceBytesHash": "300f1d6d68b475c37042e6782d7f882b8105dfca0121a4150879e19b9787d24b",
      "sourceId": "REG-XFAM-001",
      "sourcePath": "01_raw/_authoritative/REG-XFAM-001.md",
      "sourceVersionId": "SV-REGXFAM001-20260922-300f1d6d",
      "usage": "AUTHORITATIVE"
    },
    {
      "applicabilityScope": {
        "effectiveFrom": "2026-09-06",
        "effectiveTo": null
      },
      "authorityLevel": "REGULATORY",
      "claimType": "PRICE",
      "evidenceId": "EVS-REGXFAM001-c15069e6",
      "extractionRunId": "RUN-20260922-84773271",
      "fragmentId": "FRG-REGXFAM001-0005",
      "locator": {
        "clause": "第五条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "商业银行应当建立科学有效的服务价格管理体系，加强内部控制，充分披露服务价格信息，保障客户获得服务价格信息和自主选择服务的权利。",
      "quoteHash": "c15069e67e7fccb3165b12a0e2b1dccfe187ea146e2afe25bc34c2222fbaf202",
      "retrievedAt": "2026-09-22T21:40:00+08:00",
      "sourceBytesHash": "300f1d6d68b475c37042e6782d7f882b8105dfca0121a4150879e19b9787d24b",
      "sourceId": "REG-XFAM-001",
      "sourcePath": "01_raw/_authoritative/REG-XFAM-001.md",
      "sourceVersionId": "SV-REGXFAM001-20260922-300f1d6d",
      "usage": "AUTHORITATIVE"
    },
    {
      "applicabilityScope": {
        "effectiveFrom": "2026-09-06",
        "effectiveTo": null
      },
      "authorityLevel": "REGULATORY",
      "claimType": "PRICE",
      "evidenceId": "EVS-REGXFAM001-e1eb9488",
      "extractionRunId": "RUN-20260922-84773271",
      "fragmentId": "FRG-REGXFAM001-0006",
      "locator": {
        "clause": "第六条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "根据服务的性质、特点和市场竞争状况，商业银行服务价格分别实行政府指导价、政府定价和市场调节价。",
      "quoteHash": "e1eb9488b68c3d861c9cd69d6122893e85afb91f0f89897173e684cd206c10fd",
      "retrievedAt": "2026-09-22T21:40:00+08:00",
      "sourceBytesHash": "300f1d6d68b475c37042e6782d7f882b8105dfca0121a4150879e19b9787d24b",
      "sourceId": "REG-XFAM-001",
      "sourcePath": "01_raw/_authoritative/REG-XFAM-001.md",
      "sourceVersionId": "SV-REGXFAM001-20260922-300f1d6d",
      "usage": "AUTHORITATIVE"
    },
    {
      "applicabilityScope": {
        "effectiveFrom": "2026-09-06",
        "effectiveTo": null
      },
      "authorityLevel": "REGULATORY",
      "claimType": "PRICE",
      "evidenceId": "EVS-REGXFAM001-7ed0deb0",
      "extractionRunId": "RUN-20260922-84773271",
      "fragmentId": "FRG-REGXFAM001-0007",
      "locator": {
        "clause": "第七条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "中国银行业监督管理委员会和国务院价格主管部门依照有关法律、法规及本办法的规定对商业银行服务价格管理活动进行监督管理。",
      "quoteHash": "7ed0deb06c695aa7dc4ec0115b1b9a08711418bcbb29595700deb2b0ed3da39e",
      "retrievedAt": "2026-09-22T21:40:00+08:00",
      "sourceBytesHash": "300f1d6d68b475c37042e6782d7f882b8105dfca0121a4150879e19b9787d24b",
      "sourceId": "REG-XFAM-001",
      "sourcePath": "01_raw/_authoritative/REG-XFAM-001.md",
      "sourceVersionId": "SV-REGXFAM001-20260922-300f1d6d",
      "usage": "AUTHORITATIVE"
    },
    {
      "applicabilityScope": {
        "effectiveFrom": "2026-09-06",
        "effectiveTo": null
      },
      "authorityLevel": "REGULATORY",
      "claimType": "PRICE",
      "evidenceId": "EVS-REGXFAM001-2480ab03",
      "extractionRunId": "RUN-20260922-84773271",
      "fragmentId": "FRG-REGXFAM001-0009",
      "locator": {
        "clause": "第九条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "国务院价格主管部门会同中国银行业监督管理委员会，根据商业银行服务成本、服务价格对个人或企事业单位的影响程度、市场竞争状况，制定和调整商业银行政府指导价、政府定价项目及标准。",
      "quoteHash": "2480ab03712e3218525094c98ba516e792ba2fc5255fee3f3b1f9c10bc714f9a",
      "retrievedAt": "2026-09-22T21:40:00+08:00",
      "sourceBytesHash": "300f1d6d68b475c37042e6782d7f882b8105dfca0121a4150879e19b9787d24b",
      "sourceId": "REG-XFAM-001",
      "sourcePath": "01_raw/_authoritative/REG-XFAM-001.md",
      "sourceVersionId": "SV-REGXFAM001-20260922-300f1d6d",
      "usage": "AUTHORITATIVE"
    },
    {
      "applicabilityScope": {
        "effectiveFrom": "2026-09-06",
        "effectiveTo": null
      },
      "authorityLevel": "REGULATORY",
      "claimType": "PRICE",
      "evidenceId": "EVS-REGXFAM001-6e26e537",
      "extractionRunId": "RUN-20260922-84773271",
      "fragmentId": "FRG-REGXFAM001-0011",
      "locator": {
        "clause": "第十一条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "除实行政府指导价、政府定价的服务价格以外，商业银行服务价格实行市场调节价。",
      "quoteHash": "6e26e537a8c2f58db1cbb67c57decc229753e24bd3ff14170b9f7fa429684cda",
      "retrievedAt": "2026-09-22T21:40:00+08:00",
      "sourceBytesHash": "300f1d6d68b475c37042e6782d7f882b8105dfca0121a4150879e19b9787d24b",
      "sourceId": "REG-XFAM-001",
      "sourcePath": "01_raw/_authoritative/REG-XFAM-001.md",
      "sourceVersionId": "SV-REGXFAM001-20260922-300f1d6d",
      "usage": "AUTHORITATIVE"
    },
    {
      "applicabilityScope": {
        "effectiveFrom": "2026-09-06",
        "effectiveTo": null
      },
      "authorityLevel": "REGULATORY",
      "claimType": "PRICE",
      "evidenceId": "EVS-REGXFAM001-346efba7",
      "extractionRunId": "RUN-20260922-84773271",
      "fragmentId": "FRG-REGXFAM001-0012",
      "locator": {
        "clause": "第十二条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "实行市场调节价的商业银行服务价格，应当由商业银行总行制定和调整。分支机构不得自行制定和调整服务价格。",
      "quoteHash": "346efba7a6dfda878d19870d1ccfba3841b59b1a4c16eefe8393f01806bea671",
      "retrievedAt": "2026-09-22T21:40:00+08:00",
      "sourceBytesHash": "300f1d6d68b475c37042e6782d7f882b8105dfca0121a4150879e19b9787d24b",
      "sourceId": "REG-XFAM-001",
      "sourcePath": "01_raw/_authoritative/REG-XFAM-001.md",
      "sourceVersionId": "SV-REGXFAM001-20260922-300f1d6d",
      "usage": "AUTHORITATIVE"
    },
    {
      "applicabilityScope": {
        "effectiveFrom": "2026-09-06",
        "effectiveTo": null
      },
      "authorityLevel": "REGULATORY",
      "claimType": "PRICE",
      "evidenceId": "EVS-REGXFAM001-48a494da",
      "extractionRunId": "RUN-20260922-84773271",
      "fragmentId": "FRG-REGXFAM001-0014",
      "locator": {
        "clause": "第十四条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "商业银行制定和调整实行市场调节价的服务价格，应当合理测算各项服务支出，充分考虑市场因素进行综合决策。",
      "quoteHash": "48a494da8bd28ec4b0883643c056b38c426c63a163378aa62b29266703b9c19e",
      "retrievedAt": "2026-09-22T21:40:00+08:00",
      "sourceBytesHash": "300f1d6d68b475c37042e6782d7f882b8105dfca0121a4150879e19b9787d24b",
      "sourceId": "REG-XFAM-001",
      "sourcePath": "01_raw/_authoritative/REG-XFAM-001.md",
      "sourceVersionId": "SV-REGXFAM001-20260922-300f1d6d",
      "usage": "AUTHORITATIVE"
    },
    {
      "applicabilityScope": {
        "effectiveFrom": "2026-09-06",
        "effectiveTo": null
      },
      "authorityLevel": "REGULATORY",
      "claimType": "PRICE",
      "evidenceId": "EVS-REGXFAM001-ad938da7",
      "extractionRunId": "RUN-20260922-84773271",
      "fragmentId": "FRG-REGXFAM001-0015",
      "locator": {
        "clause": "第十五条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "商业银行总行向有关部门报送的本机构服务价格工作报告，包括以下内容：",
      "quoteHash": "ad938da7a64608d551bc68a2251aacb03a6c2cf0dbe00b4ae441fb23d69702e1",
      "retrievedAt": "2026-09-22T21:40:00+08:00",
      "sourceBytesHash": "300f1d6d68b475c37042e6782d7f882b8105dfca0121a4150879e19b9787d24b",
      "sourceId": "REG-XFAM-001",
      "sourcePath": "01_raw/_authoritative/REG-XFAM-001.md",
      "sourceVersionId": "SV-REGXFAM001-20260922-300f1d6d",
      "usage": "AUTHORITATIVE"
    },
    {
      "applicabilityScope": {
        "effectiveFrom": "2026-09-06",
        "effectiveTo": null
      },
      "authorityLevel": "REGULATORY",
      "claimType": "PRICE",
      "evidenceId": "EVS-REGXFAM001-ed8d6f25",
      "extractionRunId": "RUN-20260922-84773271",
      "fragmentId": "FRG-REGXFAM001-0017",
      "locator": {
        "clause": "第十七条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "客户因商业银行调整服务价格或变更服务合同，要求终止或变更银行服务的，商业银行应当根据客户要求、相关服务合同或其他已签署的法律文件采取合理有效的措施，依法及时终止或变更相关银行服务和对应的服务合同。",
      "quoteHash": "ed8d6f25db5a8f53b50cf730a83bfaaf71f2a940fad975ba0a64f06342738343",
      "retrievedAt": "2026-09-22T21:40:00+08:00",
      "sourceBytesHash": "300f1d6d68b475c37042e6782d7f882b8105dfca0121a4150879e19b9787d24b",
      "sourceId": "REG-XFAM-001",
      "sourcePath": "01_raw/_authoritative/REG-XFAM-001.md",
      "sourceVersionId": "SV-REGXFAM001-20260922-300f1d6d",
      "usage": "AUTHORITATIVE"
    },
    {
      "applicabilityScope": {
        "effectiveFrom": "2026-09-06",
        "effectiveTo": null
      },
      "authorityLevel": "REGULATORY",
      "claimType": "PRICE",
      "evidenceId": "EVS-REGXFAM001-5449ab81",
      "extractionRunId": "RUN-20260922-84773271",
      "fragmentId": "FRG-REGXFAM001-0018",
      "locator": {
        "clause": "第十八条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "商业银行向客户收取的服务费用，应当对应明确的服务内容。",
      "quoteHash": "5449ab8130ecb96f31ddb1339317e02eb3f9d4816200ee611b98dc0ec158da51",
      "retrievedAt": "2026-09-22T21:40:00+08:00",
      "sourceBytesHash": "300f1d6d68b475c37042e6782d7f882b8105dfca0121a4150879e19b9787d24b",
      "sourceId": "REG-XFAM-001",
      "sourcePath": "01_raw/_authoritative/REG-XFAM-001.md",
      "sourceVersionId": "SV-REGXFAM001-20260922-300f1d6d",
      "usage": "AUTHORITATIVE"
    },
    {
      "applicabilityScope": {
        "effectiveFrom": "2026-09-06",
        "effectiveTo": null
      },
      "authorityLevel": "REGULATORY",
      "claimType": "PRICE",
      "evidenceId": "EVS-REGXFAM001-8b5f0034",
      "extractionRunId": "RUN-20260922-84773271",
      "fragmentId": "FRG-REGXFAM001-0019",
      "locator": {
        "clause": "第十九条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "商业银行应当按规定进行服务价格信息披露。",
      "quoteHash": "8b5f003427934e252dc20b1ac604ab8a393ed190731a623d532cd15684a997b9",
      "retrievedAt": "2026-09-22T21:40:00+08:00",
      "sourceBytesHash": "300f1d6d68b475c37042e6782d7f882b8105dfca0121a4150879e19b9787d24b",
      "sourceId": "REG-XFAM-001",
      "sourcePath": "01_raw/_authoritative/REG-XFAM-001.md",
      "sourceVersionId": "SV-REGXFAM001-20260922-300f1d6d",
      "usage": "AUTHORITATIVE"
    },
    {
      "applicabilityScope": {
        "effectiveFrom": "2026-09-06",
        "effectiveTo": null
      },
      "authorityLevel": "REGULATORY",
      "claimType": "PRICE",
      "evidenceId": "EVS-REGXFAM001-ea07527b",
      "extractionRunId": "RUN-20260922-84773271",
      "fragmentId": "FRG-REGXFAM001-0021",
      "locator": {
        "clause": "第二十一条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "商业银行应当提醒客户提供真实有效的联系信息并在相关信息变更后及时通知银行，以便商业银行调整服务价格时按照合同约定方式及时告知客户。",
      "quoteHash": "ea07527bb7b40cbb663714cf3914b76ed070e714b7a1dd8dae33cd3b52ac272d",
      "retrievedAt": "2026-09-22T21:40:00+08:00",
      "sourceBytesHash": "300f1d6d68b475c37042e6782d7f882b8105dfca0121a4150879e19b9787d24b",
      "sourceId": "REG-XFAM-001",
      "sourcePath": "01_raw/_authoritative/REG-XFAM-001.md",
      "sourceVersionId": "SV-REGXFAM001-20260922-300f1d6d",
      "usage": "AUTHORITATIVE"
    },
    {
      "applicabilityScope": {
        "effectiveFrom": "2026-09-06",
        "effectiveTo": null
      },
      "authorityLevel": "REGULATORY",
      "claimType": "PRICE",
      "evidenceId": "EVS-REGXFAM001-b5cde3c5",
      "extractionRunId": "RUN-20260922-84773271",
      "fragmentId": "FRG-REGXFAM001-0022",
      "locator": {
        "clause": "第二十二条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "商业银行关于服务价格信息的公示涉及优惠措施的，应当明确标注优惠措施的生效和终止日期。",
      "quoteHash": "b5cde3c51ba98f1d445df877135e93253c5af6532b4618109f125cdd1b2c4d91",
      "retrievedAt": "2026-09-22T21:40:00+08:00",
      "sourceBytesHash": "300f1d6d68b475c37042e6782d7f882b8105dfca0121a4150879e19b9787d24b",
      "sourceId": "REG-XFAM-001",
      "sourcePath": "01_raw/_authoritative/REG-XFAM-001.md",
      "sourceVersionId": "SV-REGXFAM001-20260922-300f1d6d",
      "usage": "AUTHORITATIVE"
    },
    {
      "applicabilityScope": {
        "effectiveFrom": "2026-09-06",
        "effectiveTo": null
      },
      "authorityLevel": "REGULATORY",
      "claimType": "PRICE",
      "evidenceId": "EVS-REGXFAM001-5967f8cd",
      "extractionRunId": "RUN-20260922-84773271",
      "fragmentId": "FRG-REGXFAM001-0023",
      "locator": {
        "clause": "第二十三条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "商业银行提高实行市场调节价的服务价格，应当至少于实行前3个月按照本办法规定进行公示，必要时应当采用书面、电话、短信、电子邮件、合同约定的其他形式等多种方式通知相关客户。",
      "quoteHash": "5967f8cd6920be6b0c6b51092c4483924da76622142ddbfea07367188d5b08ea",
      "retrievedAt": "2026-09-22T21:40:00+08:00",
