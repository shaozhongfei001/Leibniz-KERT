      },
      "authorityLevel": "INTERNAL_POLICY",
      "claimType": "PROCESS",
      "evidenceId": "EVS-SRCTF001-efa0f4ad",
      "extractionRunId": "RUN-20260922-2922ed36",
      "fragmentId": "FRG-SRCTF001-0015",
      "locator": {
        "clause": "第十五条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "查询查复应按票据系统的既定流程办理，查询结果与回复内容应留档；对查询结果异常未澄清前不得办理贴现。",
      "quoteHash": "efa0f4ad2e717ff734eb2061a7edd38b842c72fbaf0f4e76c3707e5935d7269a",
      "retrievedAt": "2026-09-22T20:05:00+08:00",
