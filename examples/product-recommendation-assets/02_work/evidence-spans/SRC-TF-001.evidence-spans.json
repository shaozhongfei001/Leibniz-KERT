      "fragmentId": "FRG-SRCTF001-0014",
      "locator": {
        "clause": "第十四条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "贴现业务应核验票据真实性与背书连续性，并查验前手与出票人信用状况；**贴现条件与法定限制以 `REG-TF-001` 为准**。",
      "quoteHash": "6e56d7cc58d66663acd43d1786ed819625bd4b9c8667a30dcb4b9e55ed4a16d2",
      "retrievedAt": "2026-09-22T20:05:00+08:00",
