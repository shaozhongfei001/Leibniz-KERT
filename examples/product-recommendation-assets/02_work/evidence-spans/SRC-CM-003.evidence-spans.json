      "fragmentId": "FRG-SRCCM003-0001",
      "locator": {
        "clause": "第一条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "为规范集团客户资金集中管理的风险识别、计量与控制，防范集团授信联动风险与资金混同风险，制定本政策。",
      "quoteHash": "643304501f1c0bd904a043b750630620100c244a82635f9e583e7eb73bb76bf7",
      "retrievedAt": "2026-09-06T12:00:00+08:00",
