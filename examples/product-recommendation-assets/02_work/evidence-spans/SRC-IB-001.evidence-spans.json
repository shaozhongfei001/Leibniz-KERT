      "claimType": "RISK",
      "evidenceId": "EVS-SRCIB001-ed680e76",
      "extractionRunId": "RUN-20260922-2a797e16",
      "fragmentId": "FRG-SRCIB001-0015",
      "locator": {
        "clause": "第十五条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "贷后应至少监控：并购后企业经营与现金流实现情况、整合进展与协同效果、股权与担保物价值变动、以及是否存在**资金挪用**（挪用防范按 `SRC-FIN-005`）。",
      "quoteHash": "ed680e765b8af409764828160003d034c95104080dc2f5ce8c57ac5951852bf8",
      "retrievedAt": "2026-09-22T21:40:00+08:00",
      "sourceBytesHash": "45bd33064e341f1f9a4848841e7bbf6915cd465651f32bd62ad09dc37a4e67b9",
      "sourceId": "SRC-IB-001",
      "sourcePath": "01_raw/_authoritative/SRC-IB-001.DEMO.md",
      "sourceVersionId": "SV-SRCIB001-20260922-45bd3306",
      "usage": "AUTHORITATIVE"
