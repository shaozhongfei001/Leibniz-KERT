        "effectiveTo": null
      },
      "authorityLevel": "INTERNAL_POLICY",
      "claimType": "ELIGIBILITY",
      "evidenceId": "EVS-SRCIB001-824b907a",
      "extractionRunId": "RUN-20260922-2a797e16",
      "fragmentId": "FRG-SRCIB001-0011",
      "locator": {
        "clause": "第十一条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "**担保安排**：应至少包含股权质押或其他有效担保，并明确触发处置的条件；担保物价值应以审慎口径评估。",
      "quoteHash": "824b907a8e1873758bdc40dde9233ecd0f7a103ec8605feb6c5c159571cb7431",
      "retrievedAt": "2026-09-22T21:40:00+08:00",
