      "usage": "AUTHORITATIVE"
    },
    {
      "applicabilityScope": {
        "effectiveFrom": "2026-09-22",
        "effectiveTo": null
      },
      "authorityLevel": "INTERNAL_POLICY",
      "claimType": "ELIGIBILITY",
      "evidenceId": "EVS-SRCIB001-6c5cae25",
      "extractionRunId": "RUN-20260922-2a797e16",
      "fragmentId": "FRG-SRCIB001-0014",
      "locator": {
        "clause": "第十四条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "放款前应核查：并购交易的交割条件与付款进度是否匹配、担保与质押登记是否完成、以及内部标准的符合性。",
      "quoteHash": "6c5cae25a30f405bac97368e59214cbc8499706d042e2b9ba3659402cd7c4a8b",
      "retrievedAt": "2026-09-22T21:40:00+08:00",
      "sourceBytesHash": "45bd33064e341f1f9a4848841e7bbf6915cd465651f32bd62ad09dc37a4e67b9",
      "sourceId": "SRC-IB-001",
      "sourcePath": "01_raw/_authoritative/SRC-IB-001.DEMO.md",
      "sourceVersionId": "SV-SRCIB001-20260922-45bd3306",
