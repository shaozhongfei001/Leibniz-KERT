      "fragmentId": "FRG-SRCFIN005-0001",
      "locator": {
        "clause": "第一条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "为明确 DEMO-BANK 流动资金贷款业务的风险识别、计量与控制要求，制定本指引。",
      "quoteHash": "b264d88fd02df37d6a9d3aa546a6f12c639113ddcb20daa2f06871236d4bea38",
      "retrievedAt": "2026-09-22T21:40:00+08:00",
