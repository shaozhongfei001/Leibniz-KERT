      "extractionRunId": "RUN-20260922-2a797e16",
      "fragmentId": "FRG-SRCFIN005-0013",
      "locator": {
        "clause": "第十三条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "对风险分类为次级及以下的贷款，应制定专项清收或重组方案。",
      "quoteHash": "6ec1cb5f3130e429f9c02b3197cd188fbb67b5f2112d5e298e7371359e557d75",
      "retrievedAt": "2026-09-22T21:40:00+08:00",
