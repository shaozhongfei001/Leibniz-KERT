        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "专用存款账户用于办理各项专用资金的收付。",
      "quoteHash": "7b1e77752f5e6a4a1314d9e5df90315c267977130dc0468633ded9b896ef46d6",
      "retrievedAt": "2026-09-22T21:40:00+08:00",
