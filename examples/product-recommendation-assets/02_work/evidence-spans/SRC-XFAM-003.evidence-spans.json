      "locator": {
        "clause": "第五条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "对公产品风险等级分为五级：R1 至 R5，由产品管理部门在准入时确定并随条款变更同步复核。",
      "quoteHash": "6607eed1f7814d66371b382c8636f98d233ad836bd562fafb67c4a35c188a444",
      "retrievedAt": "2026-09-22T19:10:00+08:00",
