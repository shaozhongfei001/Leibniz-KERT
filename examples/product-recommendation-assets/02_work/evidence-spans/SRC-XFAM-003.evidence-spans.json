      "locator": {
        "clause": "第三条",
        "clauseVerified": false,
        "kind": "CLAUSE"
      },
      "quote": "销售适当性应当以客户风险承受能力、经营需求与资金用途匹配性为核心判断依据。",
      "quoteHash": "2bcc78391c5ac6c434313233ca9bec3061aaffeeb6e4fae3496fa032ed7c2afd",
      "retrievedAt": "2026-09-22T19:10:00+08:00",
