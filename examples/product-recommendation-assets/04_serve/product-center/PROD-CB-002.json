  "summary": {
    "boundaryStatement": "房地产开发、证券投资等禁止用途。",
    "isNot": [
      "房地产开发、证券投资等禁止用途。",
      "禁止用于资本外逃、股权投资等违规用途。"
    ],
    "nearestDifference": "配套产品：跨境人民币结算。",
    "oneSentenceDefinition": "内保外贷是境内银行为境内企业开立备用信用证或保函，由境外银行据此向境外企业发放贷款的跨境担保融资模式。",
    "solves": [
      "开立备用信用证/保函。",
      "支持境外银行据此放款。"
    ]
  },
